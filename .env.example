# ─── Google OAuth (existing) ──────────────────────────────────────────────────
# Required for the main workout tracker app (user login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-railway-app.up.railway.app/auth/callback
FRONTEND_URL=https://extraface.github.io/workout-tracker-backend

# ─── Anthropic (existing) ─────────────────────────────────────────────────────
# Required for the in-app Claude chat feature
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Summary Endpoint (new) ───────────────────────────────────────────────────
# Required for /summary and /summary/health endpoints

# A strong random secret key — anyone with this key can read your workout data
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
SUMMARY_API_KEY=your_summary_api_key

# Your Google Sheets spreadsheet ID (found in the sheet URL)
SUMMARY_SPREADSHEET_ID=1mvQLF5tHtR_ivU_aKfyIX54irHlGZCvdlxqJAt8KHh0

# Full contents of a Google Service Account JSON key file (read-only access to sheet)
# Steps to create:
#   1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Create a service account (e.g. "workout-summary-reader")
#   3. Keys tab → Add Key → JSON → Download
#   4. Share your Google Sheet with the service account email (Viewer access)
#   5. Paste the entire JSON file contents here (on one line, or Railway handles multiline)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com",...}
